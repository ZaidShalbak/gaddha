{
  "cleanUrls": true,
  "headers": [
    {"source": "/r/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex"}, {"key": "Referrer-Policy", "value": "no-referrer"}]},
    {"source": "/admin(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}, {"key": "Referrer-Policy", "value": "no-referrer"}, {"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/questions/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]}
  ]
}
